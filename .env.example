# ==============================================================================
# Orbit Monorepo Environment Configuration Template
# ==============================================================================

# --- Fastify Server Configuration ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:8081

# --- Supabase Configuration (Auth & Database) ---
# Your Supabase project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL=https://your-project.supabase.co
# Supabase Anon Public Key (used in mobile app client)
SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase Service Role Key (used in backend for elevated admin operations & RLS bypass where needed)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Supabase JWT Secret (found in Supabase Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# --- Database & Redis ---
# PostgreSQL connection string with pgvector enabled
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/orbit_db
REDIS_URL=redis://localhost:6379

# --- AI Models (Anthropic & OpenAI) ---
# Anthropic API Key for Claude 3.5 Sonnet / Haiku
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxx
ANTHROPIC_DEFAULT_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-20241022

# OpenAI API Key for Text Embeddings (text-embedding-3-small, 1536d) & Whisper / TTS
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx
EMBEDDING_MODEL=text-embedding-3-small

# --- Security & Cryptography ---
# 32-byte hex key for AES-256-GCM encryption of OAuth tokens at rest
# Generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- Push Notifications & Expo ---
EXPO_ACCESS_TOKEN=your-expo-access-token
