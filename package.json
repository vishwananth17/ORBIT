{
  "name": "kairo-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Kairo - Production-Ready Personal AI Agent Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:backend": "npm --workspace=@kairo/backend run dev",
    "dev:mobile": "npm --workspace=@kairo/mobile run start",
    "build:packages": "npm --workspace=@kairo/shared run build && npm --workspace=@kairo/database run build",
    "build:backend": "npm --workspace=@kairo/backend run build",
    "test": "npm --workspaces run test --if-present",
    "lint": "npm --workspaces run lint --if-present",
    "db:migrate": "npm --workspace=@kairo/database run migrate",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "keywords": [
    "ai-agent",
    "react-native",
    "expo",
    "fastify",
    "claude",
    "pgvector"
  ],
  "author": "Kairo Team",
  "license": "MIT"
}
